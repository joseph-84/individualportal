# Local dev: docker compose exposes postgres on 5433
DATABASE_URL="postgresql://portal:portal@localhost:5433/portal"

# Session signing secret (generate with: openssl rand -base64 32)
SESSION_SECRET="change-me-to-a-random-32-byte-secret"

# Seeded on first `npm run prisma:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Folder browsed/edited by the file browser module
SYNC_FOLDER_PATH="./data-mount"

# Folder holding whitelisted automation scripts
SCRIPTS_PATH="./data-scripts"

# Gmail SMTP for sending OTP codes on "특정 이메일" file shares. Generate an app
# password at https://myaccount.google.com/apppasswords (requires 2-step verification).
# Leave unset to disable email-gated sharing (the UI will show an error when used).
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Google Calendar read-only import (Settings page). Create an OAuth 2.0 Client ID at
# https://console.cloud.google.com/apis/credentials (see README "Google Calendar 연동" for
# the full setup walkthrough). Leave unset to disable the integration.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

POSTGRES_USER=portal
POSTGRES_PASSWORD=portal
POSTGRES_DB=portal
