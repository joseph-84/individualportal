# Local dev: docker compose exposes postgres on 5433
DATABASE_URL="postgresql://portal:portal@localhost:5433/portal"

# Session signing secret (generate with: openssl rand -base64 32)
SESSION_SECRET="change-me-to-a-random-32-byte-secret"

# Seeded on first `npm run prisma:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Folder browsed/edited by the file browser module
SYNC_FOLDER_PATH="./data-mount"

# Folder holding whitelisted automation scripts
SCRIPTS_PATH="./data-scripts"

POSTGRES_USER=portal
POSTGRES_PASSWORD=portal
POSTGRES_DB=portal
