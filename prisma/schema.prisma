generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Single-user portal: no roles/permissions. Being logged in grants full access.
model User {
  id               String      @id @default(cuid())
  email            String      @unique
  passwordHash     String
  name             String
  active           Boolean     @default(true)
  lastLoginAt      DateTime?
  failedLoginCount Int         @default(0)
  lockedUntil      DateTime?
  tokenVersion     Int         @default(0)
  todos            Todo[]
  notes            Note[]
  scriptRuns       ScriptRun[]
  auditLogs        AuditLog[]
  shareLinks       ShareLink[]
  apiTokens        ApiToken[]
  favorites        Favorite[]
  createdAt        DateTime    @default(now())
}

model Favorite {
  id        String   @id @default(cuid())
  title     String
  url       String
  folder    String   @default("")
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Todo {
  id          String    @id @default(cuid())
  title       String
  description String?
  project     String?
  tag         String?
  repeat      String?
  dueAt       DateTime?
  status      String    @default("todo") // "todo" | "in_progress" | "done" -- kanban column
  order       Float     @default(0) // manual drag-and-drop order among siblings (same parentId)
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id])
  parentId    String?
  parent      Todo?     @relation("TodoChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children    Todo[]    @relation("TodoChildren")
  createdAt   DateTime  @default(now())
}

model Note {
  id        String   @id @default(cuid())
  title     String
  folder    String   @default("")
  format    String   @default("md") // "md" | "html"
  content   String
  tags      String[]
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScriptDef {
  id          String      @id @default(cuid())
  file        String      @unique
  lang        String
  description String
  cron        String?
  enabled     Boolean     @default(true)
  runs        ScriptRun[]
  createdAt   DateTime    @default(now())
}

model ScriptRun {
  id          String    @id @default(cuid())
  scriptId    String
  script      ScriptDef @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  status      String
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  exitCode    Int?
  log         String    @default("")
  triggeredBy String?
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
}

model ShareLink {
  id             String     @id @default(cuid())
  token          String     @unique
  relPath        String
  scope          String // "email_otp" | "public"
  email          String? // required when scope = "email_otp"
  createdById    String
  createdBy      User       @relation(fields: [createdById], references: [id])
  revoked        Boolean    @default(false)
  lastAccessedAt DateTime?
  createdAt      DateTime   @default(now())
  otps           ShareOtp[]

  @@index([relPath])
}

model ShareOtp {
  id          String    @id @default(cuid())
  shareLinkId String
  shareLink   ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  code        String
  consumed    Boolean   @default(false)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([shareLinkId])
}

model ApiToken {
  id          String    @id @default(cuid())
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  revoked     Boolean   @default(false)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
}

// Single row per external service the user has connected (Google Calendar, etc).
model Integration {
  id           String    @id @default(cuid())
  provider     String    @unique // "google_calendar"
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  accountEmail String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  actorName String
  action    String
  target    String
  meta      String?
  createdAt DateTime @default(now())
}
