generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Single-user portal: no roles/permissions. Being logged in grants full access.
model User {
  id                 String                   @id @default(cuid())
  email              String                   @unique
  passwordHash       String
  name               String
  active             Boolean                  @default(true)
  lastLoginAt        DateTime?
  failedLoginCount   Int                      @default(0)
  lockedUntil        DateTime?
  tokenVersion       Int                      @default(0)
  todos              Todo[]
  notes              Note[]
  checklists         Checklist[]
  scriptRuns         ScriptRun[]
  auditLogs          AuditLog[]
  shareLinks         ShareLink[]
  apiTokens          ApiToken[]
  favorites          Favorite[]
  oauthCodes         OAuthAuthorizationCode[]
  oauthRefreshTokens OAuthRefreshToken[]
  createdAt          DateTime                 @default(now())
}

model Favorite {
  id        String   @id @default(cuid())
  title     String
  url       String
  folder    String   @default("")
  order     Float    @default(0) // manual drag-and-drop order among siblings (same folder)
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Todo {
  id          String    @id @default(cuid())
  title       String
  description String?
  project     String?
  tag         String?
  repeat      String?
  dueAt       DateTime?
  status      String    @default("todo") // "todo" | "in_progress" | "done" -- kanban column
  completedAt DateTime? // set when status transitions to "done", cleared otherwise -- drives the
  // "hide 2+ weeks completed" list filter (see cascadeParentCompletion/status actions)
  order       Float     @default(0) // manual drag-and-drop order among siblings (same parentId)
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id])
  parentId    String?
  parent      Todo?     @relation("TodoChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children    Todo[]    @relation("TodoChildren")
  createdAt   DateTime  @default(now())
}

model Note {
  id        String   @id @default(cuid())
  title     String
  folder    String   @default("")
  format    String   @default("md") // "md" | "html"
  content   String
  tags      String[]
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Checklist {
  id        String   @id @default(cuid())
  title     String
  folder    String   @default("")
  content   String   @default("") // Tiptap task-list HTML, same shape as Todo.description
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScriptDef {
  id          String      @id @default(cuid())
  file        String      @unique
  lang        String
  description String
  cron        String?
  enabled     Boolean     @default(true)
  runs        ScriptRun[]
  createdAt   DateTime    @default(now())
}

model ScriptRun {
  id          String    @id @default(cuid())
  scriptId    String
  script      ScriptDef @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  status      String
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  exitCode    Int?
  log         String    @default("")
  triggeredBy String?
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
}

model ShareLink {
  id             String     @id @default(cuid())
  token          String     @unique
  relPath        String
  scope          String // "email_otp" | "public"
  email          String? // required when scope = "email_otp"
  createdById    String
  createdBy      User       @relation(fields: [createdById], references: [id])
  revoked        Boolean    @default(false)
  lastAccessedAt DateTime?
  createdAt      DateTime   @default(now())
  otps           ShareOtp[]

  @@index([relPath])
}

model ShareOtp {
  id          String    @id @default(cuid())
  shareLinkId String
  shareLink   ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  code        String
  consumed    Boolean   @default(false)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([shareLinkId])
}

model ApiToken {
  id          String    @id @default(cuid())
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  revoked     Boolean   @default(false)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
}

// MCP OAuth 2.1 (claude.ai 커넥터/모바일용) -- 기존 ApiToken 정적 토큰 방식과 별개로 동작하며
// Claude Code/Desktop은 여전히 ApiToken을 그대로 쓴다. 퍼블릭 클라이언트(PKCE)만 지원하므로
// client_secret은 저장하지 않는다.
model OAuthClient {
  id            String                   @id @default(cuid()) // = client_id
  clientName    String
  redirectUris  String[]
  createdAt     DateTime                 @default(now())
  codes         OAuthAuthorizationCode[]
  refreshTokens OAuthRefreshToken[]
}

// 1회용, 단기 만료 인가 코드 (authorization_code grant 교환 전 단계).
model OAuthAuthorizationCode {
  code          String      @id @default(cuid())
  clientId      String
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  redirectUri   String
  codeChallenge String
  resource      String
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  used          Boolean     @default(false)
  expiresAt     DateTime
  createdAt     DateTime    @default(now())
}

// 액세스 토큰은 상태 없는 서명 JWT로 발급(lib/oauth.ts) -- 여기는 리프레시 토큰만 저장.
// 사용할 때마다 회전(rotate): 기존 행은 revoked 처리하고 새 행을 발급한다.
model OAuthRefreshToken {
  id        String      @id @default(cuid())
  tokenHash String      @unique
  clientId  String
  client    OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  resource  String
  revoked   Boolean     @default(false)
  createdAt DateTime    @default(now())
}

// Single row per external service the user has connected (Google Calendar, etc).
model Integration {
  id           String    @id @default(cuid())
  provider     String    @unique // "google_calendar"
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  accountEmail String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  actorName String
  action    String
  target    String
  meta      String?
  createdAt DateTime @default(now())
}
